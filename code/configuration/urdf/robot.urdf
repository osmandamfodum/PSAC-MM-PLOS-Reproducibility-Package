<?xml version="1.0"?>
<robot name="robot_4_wheels">

  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material> 
  <material name="blue"><color rgba="0 0.4 1 1"/></material>

  <link name="base_footprint"/>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.30 0.32 0.28"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.30 0.32 0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/> 
      <inertia ixx="0.8" ixy="0" ixz="0" iyy="0.8" iyz="0" izz="0.8"/>
    </inertial>
  </link>

  <joint name="neck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="neck"/>
    <origin xyz="0 0 0.16"/>
  </joint>
  <link name="neck">
    <visual>
      <geometry><cylinder length="0.04" radius="0.06"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="head_base_joint" type="fixed">
    <parent link="neck"/>
    <child link="head"/>
    <origin xyz="0 0 0.12"/>
  </joint>
  <link name="head">
    <visual>
      <geometry><sphere radius="0.15"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.15"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0 0.16"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="l_eye_joint" type="fixed">
    <parent link="head"/>
    <child link="l_eye"/>
    <origin xyz="0.12 0.06 0.02"/>
  </joint>
  <link name="l_eye">
    <visual><geometry><sphere radius="0.035"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="l_eye_optical_joint" type="fixed">
    <parent link="l_eye"/>
    <child link="l_eye_optical"/>
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
  </joint>
  <link name="l_eye_optical"></link>

  <joint name="r_eye_joint" type="fixed">
    <parent link="head"/>
    <child link="r_eye"/>
    <origin xyz="0.12 -0.06 0.02"/>
  </joint>
  <link name="r_eye">
    <visual><geometry><sphere radius="0.035"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="r_eye_optical_joint" type="fixed">
    <parent link="r_eye"/>
    <child link="r_eye_optical"/>
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
  </joint>
  <link name="r_eye_optical"></link>

  <joint name="l_shoulder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="l_shoulder"/>
    <origin xyz="0.1 0.18 0.1"/>
  </joint>
  <link name="l_shoulder">
    <visual><geometry><sphere radius="0.045"/></geometry><material name="white"/></visual>
  </link>
  
  <joint name="l_forearm_joint" type="fixed">
    <parent link="l_shoulder"/>
    <child link="l_forearm"/>
    <origin xyz="0.02 0.02 0" rpy="0 -0.8 0"/>
  </joint>
  <link name="l_forearm">
    <visual>
      <origin xyz="0 0 -0.09"/>
      <geometry><cylinder length="0.18" radius="0.025"/></geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="l_hand_joint" type="fixed">
    <parent link="l_forearm"/>
    <child link="l_hand"/>
    <origin xyz="0 0 -0.18"/>
  </joint>
  <link name="l_hand">
    <visual><geometry><cylinder radius="0.025" length="0.05"/></geometry><material name="blue"/></visual>
  </link>
  
  <joint name="l_spray_joint" type="fixed">
    <parent link="l_hand"/>
    <child link="l_spray"/>
    <origin xyz="0 0 -0.08"/>
  </joint>
  <link name="l_spray">
    <visual><geometry><cylinder radius="0.03" length="0.15"/></geometry><material name="red"/></visual>
  </link>

  <joint name="r_shoulder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="r_shoulder"/>
    <origin xyz="0.1 -0.18 0.1"/>
  </joint>
  <link name="r_shoulder">
    <visual><geometry><sphere radius="0.045"/></geometry><material name="white"/></visual>
  </link>

  <joint name="r_forearm_joint" type="fixed">
    <parent link="r_shoulder"/>
    <child link="r_forearm"/>
    <origin xyz="0.02 -0.02 0" rpy="0 -0.8 0"/>
  </joint>
  <link name="r_forearm">
    <visual>
      <origin xyz="0 0 -0.09"/>
      <geometry><cylinder length="0.18" radius="0.025"/></geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="r_hand_joint" type="fixed">
    <parent link="r_forearm"/>
    <child link="r_hand"/>
    <origin xyz="0 0 -0.18"/>
  </joint>
  <link name="r_hand">
    <visual><geometry><cylinder radius="0.025" length="0.05"/></geometry><material name="blue"/></visual>
  </link>
  
  <joint name="r_spray_joint" type="fixed">
    <parent link="r_hand"/>
    <child link="r_spray"/>
    <origin xyz="0 0 -0.08"/>
  </joint>
  <link name="r_spray">
    <visual><geometry><cylinder radius="0.03" length="0.15"/></geometry><material name="red"/></visual>
  </link>

  <joint name="fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fl_wheel"/>
    <origin xyz="0.14 0.18 -0.18" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="fl_wheel">
    <visual><geometry><cylinder length="0.08" radius="0.09"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.08" radius="0.09"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fr_wheel"/>
    <origin xyz="0.14 -0.18 -0.18" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="fr_wheel">
    <visual><geometry><cylinder length="0.08" radius="0.09"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.08" radius="0.09"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="bl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="bl_wheel"/>
    <origin xyz="-0.18 0.18 -0.18" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="bl_wheel">
    <visual><geometry><cylinder length="0.08" radius="0.09"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.08" radius="0.09"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="br_joint" type="continuous">
    <parent link="base_link"/>
    <child link="br_wheel"/>
    <origin xyz="-0.18 -0.18 -0.18" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="br_wheel">
    <visual><geometry><cylinder length="0.08" radius="0.09"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.08" radius="0.09"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_safe</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <num_wheel_pairs>2</num_wheel_pairs>
      
      <left_joint>fl_joint</left_joint>
      <right_joint>fr_joint</right_joint>
      <left_joint>bl_joint</left_joint>
      <right_joint>br_joint</right_joint>

      <wheel_separation>0.4</wheel_separation>
      <wheel_diameter>0.18</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>0.7</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf> 
      <publish_wheel_tf>true</publish_wheel_tf>
      
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
            <horizontal>
                <samples>360</samples>
                <min_angle>0</min_angle>
                <max_angle>6.28</max_angle>
            </horizontal>
        </scan>
        <range><min>0.3</min><max>12.0</max></range>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="l_eye">
    <sensor name="left_camera" type="camera">
      <camera><image><width>640</width><height>480</height></image></camera>
      <plugin name="left_camera_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>left_eye</namespace></ros>
        <frame_name>l_eye_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="r_eye">
    <sensor name="right_camera" type="camera">
      <camera><image><width>640</width><height>480</height></image></camera>
      <plugin name="right_camera_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>right_eye</namespace></ros>
        <frame_name>r_eye_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="fl_wheel"><mu1>10.0</mu1><mu2>10.0</mu2><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="fr_wheel"><mu1>10.0</mu1><mu2>10.0</mu2><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="bl_wheel"><mu1>10.0</mu1><mu2>10.0</mu2><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="br_wheel"><mu1>10.0</mu1><mu2>10.0</mu2><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="l_spray"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="r_spray"><material>Gazebo/Red</material></gazebo>

</robot>
